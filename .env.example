SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key
SUPABASE_OAUTH_REDIRECT_URL=https://your-pwa-domain.vercel.app/
SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://craft-match-verification-portal.vercel.app/update-password

# Express API must be reachable from the device or browser running the app.
EXPRESS_API_BASE_URL=https://artisansapp-backend.onrender.com/api

# Verification portal fallback for email confirmation and password reset.
VERIFICATION_PORTAL_URL=https://craft-match-verification-portal.vercel.app/

# Enable Maps JavaScript API for web and native Maps SDK restrictions separately.
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Mapbox remains native-only in the app; Google Maps is used on web.
MAPBOX_ACCESS_TOKEN=your_mapbox_token
